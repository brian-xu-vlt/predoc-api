meta {
  name: Subscribe to REQUEST_COMPLETE
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/events
  body: json
  auth: inherit
}

headers {
  Accept: application/json
}

body:json {
  {
    "eventType": "REQUEST_COMPLETE",
    "serviceName": "Inato demo",
    "notificationEmail": "{{requestingProviderEmail}}",
    "webhookUri": "{{webhookUri}}",
    "customHeaders": [
      {
        "key": "X-Partner-Auth",
        "value": "{{process.env.PREDOC_WEBHOOK_SECRET}}"
      }
    ]
  }
}

script:pre-request {
  if (bru.getVar("configurationId")) {
    bru.runner.skipRequest();
  }
}

script:post-response {
  bru.setVar("configurationId", res.body.configurationId);
}

tests {
  test("responds 2xx", () => {
    expect(res.status).to.be.within(200, 299);
  });
}

docs {
  Skipped when a `REQUEST_COMPLETE` subscription to `webhookUri` already exists.

  Predoc documents no webhook signature, so a shared secret is sent in `customHeaders`.
}
