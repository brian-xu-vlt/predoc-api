meta {
  name: Upload anonymous PDF
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/records/upload/anonymous
  body: multipart-form
  auth: inherit
}

headers {
  Accept: application/json
}

body:multipart-form {
  file: @file(fixtures/sample-record.pdf)
  fileName: sample-record-{{$timestamp}}.pdf
  urgent: false
}

script:post-response {
  bru.setVar("recordUploadId", res.body.recordUploadId);
}

tests {
  test("responds 2xx", () => {
    expect(res.status).to.be.within(200, 299);
  });
}

docs {
  Uploads the synthetic `fixtures/sample-record.pdf`. `fileName` must be unique, hence the timestamp.
}
