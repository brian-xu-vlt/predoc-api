meta {
  name: Get patient documents
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/v1/patients/:patientId/documents
  body: none
  auth: inherit
}

params:path {
  patientId: {{patientId}}
}

headers {
  Accept: application/json
}

tests {
  test("responds 2xx", () => {
    expect(res.status).to.be.within(200, 299);
  });
}

docs {
  All documents attached to the patient.
}
