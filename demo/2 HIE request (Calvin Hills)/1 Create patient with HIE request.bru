meta {
  name: Create patient with HIE request
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v2/requests
  body: json
  auth: inherit
}

headers {
  Accept: application/json
}

body:json {
  {
    "releaseToOrgName": "Inato Demo Site",
    "releaseToProviderName": "Dr. Demo Investigator",
    "requestingProviderEmail": "{{requestingProviderEmail}}",
    "reasonForRequest": 2,
    "previousProviders": [],
    "referenceId": "demo-{{$timestamp}}",
    "allowDuplicatePatient": true,
    "sendHieRequest": true,
    "sendMedicationsRequest": false,
    "patientAddress": {
      "addressLine1": "765 Dickinson Annex Unit 1",
      "city": "Madison",
      "stateCode": "WI",
      "postalCode": "53714"
    },
    "patientGender": "male",
    "firstName": "Calvin",
    "lastName": "Hills",
    "dateOfBirth": "1989-08-16",
    "phoneNumber": "5557578394",
    "facesheetConfigIds": [
      "{{facesheetConfigId}}"
    ]
  }
}

script:post-response {
  bru.setVar("patientId", res.body.partnerPatientId);
  bru.setVar("requestId", res.body.requestId);
  bru.setVar("retrievalId", res.body.previousProviderRetrievals?.[0]?.id);
}

tests {
  test("responds 2xx", () => {
    expect(res.status).to.be.within(200, 299);
  });
}

docs {
  Sandbox HIE test patient. `allowDuplicatePatient` lets the demo be replayed.
}
