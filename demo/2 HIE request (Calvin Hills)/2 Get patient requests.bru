meta {
  name: Get patient requests
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/patients/:patientId/requests
  body: none
  auth: inherit
}

params:path {
  patientId: {{patientId}}
}

headers {
  Accept: application/json
}

tests {
  test("responds 2xx", () => {
    expect(res.status).to.be.within(200, 299);
  });
}

docs {
  Check `cumulativeRequestStatus`. Re-run until the HIE request is `COMPLETED`.
}
