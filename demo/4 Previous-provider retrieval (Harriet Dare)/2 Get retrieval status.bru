meta {
  name: Get retrieval status
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/retrievals/previous-providers/:retrievalId
  body: none
  auth: inherit
}

params:path {
  retrievalId: {{retrievalId}}
}

headers {
  Accept: application/json
}

script:post-response {
  bru.setVar("retrievalCanClose", res.body.canClose === true);
}

tests {
  test("responds 2xx", () => {
    expect(res.status).to.be.within(200, 299);
  });
}

docs {
  Check `status`, `statusGroup` and `canClose`.
}
