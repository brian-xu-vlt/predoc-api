meta {
  name: Create patient with previous-provider request
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v2/requests
  body: json
  auth: inherit
}

headers {
  Accept: application/json
}

body:json {
  {
    "releaseToOrgName": "Inato Demo Site",
    "releaseToProviderName": "Dr. Demo Investigator",
    "requestingProviderEmail": "{{requestingProviderEmail}}",
    "reasonForRequest": 2,
    "previousProviders": [
      {
        "orgName": "Sandbox Family Clinic",
        "practiceName": "Sandbox Family Clinic",
        "providerFirstName": "Jane",
        "providerLastName": "Doe",
        "datesOfService": {
          "serviceStartDate": "2024-01-01",
          "serviceEndDate": "2025-12-31"
        },
        "orgAddress": {
          "addressLine1": "123 Main St",
          "city": "Madison",
          "stateCode": "WI",
          "postalCode": "53703",
          "countryCode": "USA"
        },
        "orgPhoneCountryCode": "+1",
        "orgPhoneNumber": "5553643856",
        "orgFaxNumber": "5553643856"
      }
    ],
    "sendHieRequest": false,
    "sendMedicationsRequest": false,
    "referenceId": "demo-{{$timestamp}}",
    "allowDuplicatePatient": true,
    "firstName": "Harriet",
    "lastName": "Dare",
    "dateOfBirth": "1957-05-20",
    "phoneNumber": "5557263278",
    "patientGender": "female",
    "patientAddress": {
      "addressLine1": "554 Bechtelar Annex",
      "city": "Madison",
      "stateCode": "WI",
      "postalCode": "53715"
    }
  }
}

script:post-response {
  bru.setVar("patientId", res.body.partnerPatientId);
  bru.setVar("requestId", res.body.requestId);
  bru.setVar("retrievalId", res.body.previousProviderRetrievals?.[0]?.id);
}

tests {
  test("responds 2xx", () => {
    expect(res.status).to.be.within(200, 299);
  });
}

docs {
  The provider is fake. The sandbox has no documented way to complete a previous-provider retrieval: ask Predoc.
}
