meta {
  name: Medications - Juniper Williston
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/v2/requests
  body: json
  auth: inherit
}

headers {
  Accept: application/json
}

body:json {
  {
    "releaseToOrgName": "Inato Demo Site",
    "releaseToProviderName": "Dr. Demo Investigator",
    "requestingProviderEmail": "{{requestingProviderEmail}}",
    "reasonForRequest": 2,
    "previousProviders": [],
    "referenceId": "demo-{{$timestamp}}",
    "allowDuplicatePatient": true,
    "sendHieRequest": false,
    "sendMedicationsRequest": true,
    "patientAddress": {
      "addressLine1": "198 Huie ,",
      "city": "Jonesboro",
      "stateCode": "GA",
      "postalCode": "30236"
    },
    "patientGender": "female",
    "firstName": "Juniper",
    "lastName": "Williston",
    "dateOfBirth": "2016-02-29",
    "phoneNumber": "5555555555"
  }
}

script:post-response {
  bru.setVar("patientId", res.body.partnerPatientId);
  bru.setVar("requestId", res.body.requestId);
  bru.setVar("retrievalId", res.body.previousProviderRetrievals?.[0]?.id);
}

tests {
  test("responds 2xx", () => {
    expect(res.status).to.be.within(200, 299);
  });
}

docs {
  Demographics copied verbatim from https://docs.predoc.ai/reference/sandbox-test-patients

  The docs give no phone number for this patient, but `phoneNumber` is required: `5555555555` is a placeholder.
}
