meta {
  name: Create Patient with Record Request V2
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v2/requests
  body: json
  auth: inherit
}

headers {
  Accept: application/json
}

body:json {
  {
    "releaseToOrgName": "Inato Demo Site",
    "releaseToProviderName": "Dr. Demo Investigator",
    "requestingProviderEmail": "{{requestingProviderEmail}}",
    "reasonForRequest": 2,
    "previousProviders": [],
    "referenceId": "demo-{{$timestamp}}",
    "allowDuplicatePatient": true,
    "sendHieRequest": true,
    "sendMedicationsRequest": false,
    "patientAddress": {
      "addressLine1": "765 Dickinson Annex Unit 1",
      "city": "Madison",
      "stateCode": "WI",
      "postalCode": "53714"
    },
    "patientGender": "male",
    "firstName": "Calvin",
    "lastName": "Hills",
    "dateOfBirth": "1989-08-16",
    "phoneNumber": "5557578394"
  }
}

script:post-response {
  bru.setVar("patientId", res.body.partnerPatientId);
  bru.setVar("requestId", res.body.requestId);
  bru.setVar("retrievalId", res.body.previousProviderRetrievals?.[0]?.id);
}

docs {
  Creates a patient and a record-retrieval request, associates them with the organization for the authenticated credential, and returns a request ID for checking status and retrieving documents programmatically. V2 also protects against creating duplicate patients with the same personally identifiable information.

  ### Example response 201 Created

  ```json
  {
    "partnerPatientId": "458cbe68-f15c-0819-5a3f-641e24404587",
    "requestId": "268ac18c-47d6-6b6a-a489-954e5414d786",
    "message": "Patient created successfully",
    "previousProviderRetrievals": [
      {
        "id": "11111111-1111-4111-8111-111111111111"
      },
      {
        "id": "11111111-1111-4111-8111-111111111111"
      }
    ],
    "referenceId": "1234567890"
  }
  ```
}
