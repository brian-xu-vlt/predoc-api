meta {
  name: Get Previous-Provider Retrieval Status
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/retrievals/previous-providers/:retrievalId
  body: none
  auth: inherit
}

params:path {
  retrievalId: {{retrievalId}}
}

headers {
  Accept: application/json
}

docs {
  Gets the current status for a manual previous-provider retrieval by retrieval UUID.

  ### Fields

  | Field | Description |
  |---|---|
  | `retrievalId` | Retrieval id UUID. |

  ### Example response 200 OK

  ```json
  {
    "retrievalId": "11111111-1111-4111-8111-111111111111",
    "partnerPatientId": "352eded2-ac76-b2f0-3e5f-b413b6e33fa8",
    "requestId": "8e8c292d-119c-08de-9bce-02d72df36bd1",
    "status": "Processing",
    "statusGroup": "PROCESSING",
    "updatedAt": "1998-09-08T09:03:25.197Z",
    "canClose": true
  }
  ```
}
