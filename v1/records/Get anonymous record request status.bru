meta {
  name: Get anonymous record request status
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/v1/records/uploads/:recordUploadId/status
  body: none
  auth: inherit
}

params:path {
  recordUploadId: {{recordUploadId}}
}

headers {
  Accept: application/json
}

docs {
  Retrieves the processing status for an anonymous record upload request.

  ### Fields

  | Field | Description |
  |---|---|
  | `recordUploadId` | The ID of the record upload request. |

  ### Example response 200 OK

  ```json
  {
    "recordUploadId": "string",
