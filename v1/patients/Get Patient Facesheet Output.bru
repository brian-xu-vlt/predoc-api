meta {
  name: Get Patient Facesheet Output
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/v1/patients/:patientId/facesheets/requests/:facesheetRequestId/output
  body: none
  auth: inherit
}

params:path {
  patientId: {{patientId}}
  facesheetRequestId: {{facesheetRequestId}}
}

headers {
  Accept: application/json
}

docs {
  Returns the finalized facesheet questions, answers, rationale, and source references. Partner-facing display text is returned without literal `|` separators, while identifiers, URLs, statuses, dates, splice metadata, and source metadata are preserved as received.

  ### Fields

  | Field | Description |
  |---|---|
  | `patientId` | Unique identifier of the patient. |
  | `facesheetRequestId` | Unique identifier of the facesheet request. |

