meta {
  name: Get Patient Medications
  type: http
  seq: 16
}

get {
  url: {{baseUrl}}/v1/patients/:patientId/medications
  body: none
  auth: inherit
}

params:path {
  patientId: {{patientId}}
}

headers {
  Accept: application/json
}

docs {
  Gets a list of medications for the patient by ID.

  ### Fields

  | Field | Description |
  |---|---|
  | `patientId` | Unique identifier of the patient. |

  ### Example response 200 OK

  ```json
