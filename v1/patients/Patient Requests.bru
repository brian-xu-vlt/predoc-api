meta {
  name: Patient Requests
  type: http
  seq: 19
}

get {
  url: {{baseUrl}}/v1/patients/:patientId/requests
  body: none
  auth: inherit
}

params:path {
  patientId: {{patientId}}
}

headers {
  Accept: application/json
}

docs {
  Returns all requests for the patient, regardless of status, so the organization can track each request’s progress.

  ### Fields

  | Field | Description |
  |---|---|
  | `patientId` | Unique identifier of the patient. |

